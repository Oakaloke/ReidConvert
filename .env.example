# ReidConvert — environment variables (EXAMPLE)
# Copy to `.env` for the serverless Stripe functions. NEVER commit the real .env.
# The static site itself does NOT read this file; its public config lives in
# assets/js/config.js (copied from assets/js/config.example.js). See docs/STRIPE_SETUP.md.

# ---- Supabase (server side, for the serverless functions only) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # SECRET — server only, bypasses Row Level Security

# ---- Stripe (server side only) ----
STRIPE_SECRET_KEY=                # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=            # whsec_...
STRIPE_PRICE_ID=                  # price_... for the monthly Member plan
STRIPE_SUCCESS_URL=https://reidconvert.com/account/?checkout=success
STRIPE_CANCEL_URL=https://reidconvert.com/pricing/?checkout=cancel
